{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Netzblick",
  "mainBinaryName": "netzblick",
  "version": "../package.json",
  "identifier": "at.xionix.netzblick",
  "build": {
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../www"
  },
  "app": {
    "windows": [],
    "withGlobalTauri": false,
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "app", "dmg", "appimage", "deb"],
    "publisher": "geister-it",
    "copyright": "© 2026 geister-it",
    "homepage": "https://github.com/xionix3/netzblick",
    "license": "MIT",
    "category": "Utility",
    "shortDescription": "Stromverbrauch aus dem Smart-Meter-Portal von Netz Burgenland",
    "longDescription": "Inoffizielles Programm von geister-it für die Verbrauchsdaten aus dem Smart-Meter-Portal und dem Kundenportal von Netz Burgenland. Alle Daten bleiben auf deinem Computer.",
    "icon": [
      "icons/32x32.png",
      "icons/64x64.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["German", "English"],
        "displayLanguageSelector": false
      }
    },
    "macOS": {
      "minimumSystemVersion": "10.15",
      "signingIdentity": "-"
    },
    "linux": {
      "deb": {
        "section": "utils"
      }
    }
  }
}
