{
  "name": "netzblick",
  "version": "1.8.7",
  "private": true,
  "type": "module",
  "description": "Inoffizielle App für die Verbrauchsdaten aus dem Smart-Meter-Portal von Netz Burgenland (Android, Windows, macOS, Linux)",
  "author": "geister-it",
  "license": "SEE LICENSE IN LICENSE",
  "repository": {
    "type": "git",
    "url": "https://github.com/xionix3/netzblick.git"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "prebuild": "node scripts/ensure-deps.mjs",
    "build": "node scripts/build.mjs",
    "sync": "npm run build && npx cap sync android",
    "apk": "npm run sync && cd android && ./gradlew assembleDebug",
    "test": "node --test --test-reporter=spec \"test/unit/*.test.mjs\"",
    "test:e2e": "node test/e2e/smoke.mjs",
    "screenshots": "node test/e2e/smoke.mjs --screenshots",
    "check": "npm test && npm run build && npm run test:e2e"
  },
  "dependencies": {
    "@capacitor/android": "^8.6.2",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.6.2",
    "@capacitor/filesystem": "^8.1.5",
    "@capacitor/local-notifications": "^8.3.1",
    "@capacitor/share": "^8.0.3",
    "@fontsource/barlow": "^5.3.0",
    "@fontsource/barlow-semi-condensed": "^5.3.0",
    "@tauri-apps/api": "^2.12.5",
    "echarts": "^6.1.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.2",
    "@tauri-apps/cli": "^2.12.6",
    "esbuild": "^0.28.2",
    "puppeteer-core": "^25.17.0"
  },
  "allowScripts": {
    "esbuild": true
  }
}
